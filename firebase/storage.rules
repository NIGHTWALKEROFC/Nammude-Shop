rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Product photos: anyone can view (needed to show them on the public
    // customer site). Only a logged-in admin can upload, and only small
    // images — the admin app also resizes images before upload, this is
    // a hard backend limit so nothing large ever gets accepted even if
    // someone bypasses the app.
    match /shops/{shopId}/products/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 3 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
