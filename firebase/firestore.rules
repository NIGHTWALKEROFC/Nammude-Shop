rules_version = '2';

// HOW TO READ THIS FILE
// "allow get"  = someone fetching ONE document they already know the ID of.
// "allow list" = someone fetching a whole collection / running a query.
// Splitting these two is what lets a customer read their own order using
// its unguessable order code, while still blocking anyone from browsing
// (listing) every order in the shop.
//
// KNOWN LIMITATION (documented on purpose, not fixed here):
// Rules validate the ORDER document and, below, cross-check each item's
// price against the live product doc - but rules cannot force the
// accompanying stock-decrement writes in the app's transaction to actually
// happen; a request crafted to call the Firestore API directly (bypassing
// app.js) could create a valid-looking order without ever decrementing
// stock. Fully closing that gap needs a trusted server (e.g. a Cloud
// Function on the paid Blaze plan). The mitigations below (live price
// cross-check, total = subtotal + deliveryFee check, size caps, isOpen
// check, exact field allow-list) meaningfully shrink the abuse surface -
// a forged order can no longer under-price items, inflate its total, add
// unexpected fields, or bypass the closed-shop toggle - while the worst
// remaining case is a spurious order with no real stock impact, which the
// shop owner can simply cancel from the admin dashboard.

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null;
      // Every account created in Firebase Authentication for this project
      // is an admin (the spec only requires owner/staff login, not customer
      // accounts). If you later give staff different permission levels,
      // replace this with a check against an adminUsers/{uid} doc.
    }

    function isValidStockDecrement() {
      let before = resource.data;
      let after = request.resource.data;
      return after.stock is number &&
             after.stock >= 0 &&
             after.stock < before.stock &&
             // no other field may change in this kind of write
             after.diff(before).affectedKeys().hasOnly(['stock']);
    }

    function isValidNewOrder(shopId) {
      let d = request.resource.data;
      return d.keys().hasOnly([
               'shopId', 'customerName', 'phone', 'address', 'note', 'items',
               'subtotal', 'deliveryFee', 'total', 'status', 'lang',
               'createdAt', 'updatedAt'
             ]) &&
             d.status == 'New' &&
             d.shopId is string && d.shopId == shopId &&
             d.customerName is string && d.customerName.size() > 0 && d.customerName.size() <= 200 &&
             d.phone is string && d.phone.size() > 0 && d.phone.size() <= 30 &&
             (!('address' in d) || (d.address is string && d.address.size() <= 500)) &&
             (!('note' in d) || (d.note is string && d.note.size() <= 500)) &&
             (!('lang' in d) || d.lang in ['en', 'ml']) &&
             d.items is list && d.items.size() > 0 && d.items.size() <= 50 &&
             d.items.all(i,
               i.productId is string &&
               i.qty is number && i.qty > 0 && i.qty <= 999 &&
               i.price is number && i.price >= 0 &&
               // The price on each order item must match the product's
               // CURRENT live price. This is the one cross-document check
               // rules can do without a server, and it stops a forged
               // request from checking out at a fake (lower) price.
               i.price == get(/databases/$(database)/documents/shops/$(shopId)/products/$(i.productId)).data.price
             ) &&
             d.subtotal is number && d.subtotal >= 0 &&
             d.deliveryFee is number && d.deliveryFee >= 0 &&
             d.total is number && d.total >= 0 &&
             // The total must actually be subtotal + deliveryFee, so a
             // forged request can't lower the total while keeping items
             // that price-check individually.
             d.total == d.subtotal + d.deliveryFee &&
             // Server-side enforcement of the shop's open/closed toggle -
             // mirrors the client-side check in checkout, but this is the
             // one that actually can't be bypassed from devtools.
             get(/databases/$(database)/documents/shops/$(shopId)).data.isOpen != false;
    }

    match /shops/{shopId} {
      allow read: if true;                 // shop name/logo/open-closed is public
      allow write: if isAdmin();

      match /categories/{categoryId} {
        allow read: if true;
        allow write: if isAdmin();
      }

      match /products/{productId} {
        allow read: if true;
        // Admin can change anything. A customer's checkout transaction can
        // ONLY decrement stock (never price/name), and never below zero -
        // this is what lets stock be verified and reduced without needing
        // a paid Cloud Function.
        allow update: if isAdmin() || isValidStockDecrement();
        allow create, delete: if isAdmin();
      }

      match /orders/{orderId} {
        // Document ID is the random order code (e.g. SHOP-7K42P), so "get"
        // effectively requires already knowing that code.
        allow get: if true;
        allow list: if isAdmin();
        allow create: if isValidNewOrder(shopId);
        allow update, delete: if isAdmin();   // only the shop can change order status
      }

      match /notifications/{notificationId} {
        allow read: if true;         // notification/announcement history, shown to all customers
        allow write: if isAdmin();
      }
    }

    match /adminUsers/{uid} {
      allow read: if isAdmin() && request.auth.uid == uid;
      allow write: if false; // manage via Firebase Console / Admin SDK only
    }
  }
}
